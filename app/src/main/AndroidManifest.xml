<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:description="@string/app_desc"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CleanShare">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CleanShare.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".ui.MainActivity"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- No signature permission: hook caller (intentresolver) has a different signature.
             Caller identity is verified at runtime inside DeletionProvider.call(). -->
        <provider
            android:name=".deletion.DeletionProvider"
            android:authorities="eu.hxreborn.cleanshare.deletion"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <provider
            android:name=".deletion.ScreenshotQueryProvider"
            android:authorities="eu.hxreborn.cleanshare.query"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Remove unused AndroidX auto-registered components -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove"
            tools:ignore="MissingClass" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove"
            tools:ignore="MissingClass" />
    </application>

</manifest>
