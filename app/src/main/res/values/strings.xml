<resources>
    <string name="app_name">CleanShare</string>
    <string name="app_desc">Hides share-sheet suggestions and can auto-delete screenshots</string>

    <!-- Settings categories -->
    <string name="pref_category_features">Share Sheet</string>
    <string name="pref_category_deletion">Screenshot Cleanup</string>
    <string name="pref_category_about">About</string>

    <!-- Feature prefs -->
    <string name="pref_hide_direct_share_title">Hide Direct Share</string>
    <string name="pref_hide_direct_share_summary">Removes the suggested contacts row from the system share sheet</string>
    <string name="pref_hide_quick_share_title">Hide Quick Share</string>
    <string name="pref_hide_quick_share_summary">Removes Google Quick Share from the list of sharing options</string>
    <plurals name="pref_app_filter_summary_block">
        <item quantity="one">%d app hidden from share sheet</item>
        <item quantity="other">%d apps hidden from share sheet</item>
    </plurals>
    <plurals name="pref_app_filter_summary_allow">
        <item quantity="one">%d app shown in share sheet</item>
        <item quantity="other">%d apps shown in share sheet</item>
    </plurals>
    <string name="app_filter_mode_block">Hide selected</string>
    <string name="app_filter_mode_allow">Show only selected</string>
    <string name="app_filter_none_block">No apps hidden. All apps shown in share sheet</string>
    <string name="app_filter_none_allow">No apps selected. All apps shown in share sheet</string>
    <string name="pref_hide_launcher_icon_title">Hide Launcher Icon</string>
    <string name="pref_hide_launcher_icon_summary">Hides app from launcher. You can still open it from your Xposed manager, such as LSPosed or Vector</string>

    <!-- Deletion prefs -->
    <string name="pref_deletion_enabled_title">Delete Shared Screenshots</string>
    <string name="pref_deletion_enabled_summary">Removes screenshots from your device after sharing</string>
    <string name="pref_deletion_requires_root">Root access is required for screenshot deletion</string>
    <string name="pref_deletion_mode_title">Deletion Mode</string>
    <string name="pref_deletion_mode_summary_ask">Adds a \"Delete after sharing\" checkbox to the share sheet. Remembers your last choice</string>
    <string name="pref_deletion_mode_summary_always">Automatically deletes the screenshot in the background without showing a checkbox</string>
    <string name="pref_deletion_action_title">Deletion Action</string>
    <string name="pref_deletion_action_summary_delete">Permanently removes the file. Cannot be recovered</string>
    <string name="pref_deletion_action_summary_trash">Moves the file to trash. Android keeps it for 30 days before removing it</string>
    <string name="pref_deletion_delay_title">Deletion Delay</string>
    <string name="pref_deletion_delay_summary">Waits %d seconds before deleting, ensuring the target app has time to process the image</string>
    <string name="pref_show_toast_title">Show Toast</string>
    <string name="pref_show_toast_summary">Shows a brief notification after each deletion</string>
    <string name="pref_screenshot_pattern_title">Filename Pattern</string>
    <string name="pref_screenshot_pattern_summary">Advanced: Custom regex pattern to identify screenshot files</string>

